# Dyad hosted-deployment environment (deploy/env on the VM)
# Copy to deploy/env and fill in: HOSTNAME + the two secrets from setup-secrets.sh.
# This file is loaded by dyad-web.service (EnvironmentFile) and inherited by
# the headless server + Vite spawns (run-headless-browser.mjs spreads process.env).

# ── Public hostname ─────────────────────────────────────────────────────────
# sslip.io pattern: the VM's public IP with dots replaced by dashes.
# Example: IP 123.45.67.89 → 123-45-67-89.sslip.io
DYAD_PUBLIC_HOSTNAME=YOUR-VM-IP-WITH-DASHES.sslip.io

# ── Secrets (generated once by deploy/setup-secrets.sh — do not commit) ──────
# Shared bearer token for /rpc + /ws; the renderer gets it baked in at Vite
# startup and the server enforces it. Pinned (not per-launch) so browser tabs
# survive server restarts.
DYAD_RPC_TOKEN=REPLACE_ME
DYAD_RPC_ALLOWED_ORIGINS=https://YOUR-VM-IP-WITH-DASHES.sslip.io,https://127.0.0.1:4173,http://127.0.0.1:4173

# ── Data + serving ───────────────────────────────────────────────────────────
DYAD_DATA_DIR=/opt/dyad/deploy-userData
DYAD_VITE_ALLOWED_HOSTS=YOUR-VM-IP-WITH-DASHES.sslip.io
VITE_PREVIEW_URL_TEMPLATE=https://YOUR-VM-IP-WITH-DASHES.sslip.io/preview/{port}
DYAD_PREVIEW_PUBLIC_URL_BASE=https://YOUR-VM-IP-WITH-DASHES.sslip.io/preview

# ── Services co-located on the VM ────────────────────────────────────────────
DYAD_OPENVIKING_URL=http://127.0.0.1:1933

# ── Observability (optional) ─────────────────────────────────────────────────
# Set all three to enable Langfuse tracing (free tier: cloud.langfuse.com).
# Leave unset to keep tracing off.
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=